APP_NAME="Booking System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (PostgreSQL)
# اگر می‌خواهید به یک سرویس ابری مثل Neon وصل شوید، DATABASE_URL را پر کنید؛
# در غیر این صورت مقادیر جداگانه‌ی زیر استفاده می‌شوند.
DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=booking_db
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Cache / Redis
# اگر می‌خواهید به یک سرویس ابری مثل Upstash وصل شوید، REDIS_URL را پر کنید
# (برای اتصال TLS از rediss:// استفاده کنید)؛ در غیر این صورت مقادیر جداگانه‌ی زیر استفاده می‌شوند.
CACHE_STORE=redis
REDIS_CLIENT=predis
# REDIS_URL=rediss://default:password@host:6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_TTL=60

# Queue (used to send confirmation emails without blocking the response,
# same intent as the .catch()-without-await pattern in the NestJS version)
QUEUE_CONNECTION=sync

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=no-reply@booking.com
MAIL_FROM_NAME="Booking System"

# App-specific
BOOKING_EXPIRATION_MINUTES=30

# مسیر /setup: فعال‌سازی اجرای migration + seeder از طریق URL (بدون توکن)
# برای بستن کامل مسیر بگذارید: SETUP_ENABLED=false
SETUP_ENABLED=true
# فقط در شرایط خاص (مثلاً ری‌ست کامل دمو) true بگذارید
ALLOW_DESTRUCTIVE_SETUP=false
